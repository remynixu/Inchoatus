{
    "version": "2.0.0",
    "tasks": [
        /* DEBUG */
        {
            "label": "0. Clean Build (Debug)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path 'build') { Remove-Item -Recurse -Force 'build'}"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "1. CMake Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}\\.",
                "-B", "${workspaceFolder}\\build",
                "-G", "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "dependsOn": [
                "0. Clean Build (Debug)"
            ]
        },
        {
            "label": "PRELAUNCH",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build", "-j2"
            ],
            "dependsOn": [
                "1. CMake Configure (Debug)"
            ]
        },

        /*
        {
