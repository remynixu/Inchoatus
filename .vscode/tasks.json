        /* RELEASE */
        {
            "label": "0. Clean Build (Release)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path 'build') { Remove-Item -Recurse -Force 'build'}; if (Test-Path 'Arundel.zip' -PathType Leaf) { Remove-Item -Force 'Arundel.zip' }; if (Test-Path 'Arundel') { Remove-Item -Force 'Arundel'}"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "1. CMake Configure (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}\\.",
                "-B", "${workspaceFolder}\\build",
                "-G", "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "dependsOn": [
                "0. Clean Build (Release)"
            ]
        },
        {
            "label": "2. CMake Build (Release)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "build", "-j2"
            ],
            "dependsOn": [
                "1. CMake Configure (Release)"
            ]
        },
        {
            "label": "3. Package Playable Zip",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "Compress-Archive -Path 'build/Inchoatus.exe' -DestinationPath 'Inchoatus.zip' -Force"
            ],
            "group": {
                "kind": "build",
                "isDefault": true // Ctrl+Shift+B
            },
            "dependsOn": [
                "2. CMake Build (Release)"
            ]
        }

